# Upstream Min setting (used with pnpm). Harmless under npm; kept so the
# imported tree stays recognisably upstream.
node-linker=hoisted

# --- local, self-contained dependency state --------------------------------
#
# node_modules/ is already project-local, so it needs nothing here. npm's
# package cache does not: it defaults to ~/.npm (already 2.6G on this machine).
#
# The value is relative, and npm resolves a relative path against the directory
# holding this file — verified with `npm config get cache`. Deleting the
# checkout therefore deletes all dependency state.
#
# The remaining caches are environment variables rather than npm config, so they
# live in scripts/devEnv.sh: Electron's binary download, electron-builder's fpm
# and appimage helpers, and node-gyp's headers. Note that npm does *not* resolve
# a relative `devdir` the way it resolves `cache`, which is why node-gyp's
# header cache is set absolutely in that script instead of here. Source it
# before installing or building.

cache=./.cache/npm
