#!/bin/sh
set -e

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ]; then
    update-alternatives --install /usr/bin/x-www-browser \
        x-www-browser /opt/Mercury/mercury-browser 80
    chown root /opt/Mercury/chrome-sandbox
    chmod 4755 /opt/Mercury/chrome-sandbox
    echo "Run sudo xdg-settings set default-web-browser org.mercury.Browser.desktop && sudo update-alternatives --config x-www-browser to set Mercury as your default browser."
    ln -sf /opt/Mercury/mercury-browser /usr/bin/mercury-browser
fi
